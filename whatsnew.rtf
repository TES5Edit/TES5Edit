\pard\sb300\sa180{\b\f0\fs32\ulth Scripting improvements}\par
\pard\sa180{\f0\fs24 function RecordFromFileByFormID(aeFile: IwbFile|string; aiFormID: integer|string): IwbMainRecord can be used to get a main record interface.}\par
\pard\sa180{\f0\fs24 The file can be specified using a file interface or a string consisting of the module filename.}\par
\pard\sa180{\f0\fs24 The FormID can be specified using an integer value or a string.}\par
\pard\sa180{\f0\fs24 You can mix and match.}\par
\pard\sa180{\f0\fs24 Examples}\par
\pard\sa180{\f0\fs24 var}\par
\pard\sa180{\f0\fs24 eFile : IwbFile;}\par
\pard\sa180{\f0\fs24 rec   : IwbMainRecord;}\par
\pard\sa180{\f0\fs24 Begin}\par
\pard\sa180{\f0\fs24 eFile := FileByName('Skyrim.esm');}\par
\pard\sa180{\f0\fs24 rec := RecordFromFileByFormID(eFile, $0000000F);}\par
\pard\sa180{\f0\fs24 rec := RecordFromFileByFormID(eFile, '0000000F');}\par
\pard\sa180{\f0\fs24 rec := RecordFromFileByFormID('Skyrim.esm', '0000000F');}\par
\pard\sa180{\f0\fs24 end;}\par
